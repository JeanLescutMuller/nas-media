# nas-media's settings for one home. Copy to ~/.config/nas-media/nas.env on the NAS (chmod 600) and fill in; never commit it.
# Read by install.sh, uninstall.sh, compose.yaml (through install.sh), src/keep_ahead.py, src/listen.py, tools/configure.py.
# One KEY=value per line; comments on their own lines; quote a value with spaces.

# Name of the scheduled job and of its service (systemd --user), e.g. com.<you>.nas-media
NAME=com.example.nas-media
# The media folder (Plex's libraries and the torrents): Plex, Sonarr and Radarr see it as /media, qBittorrent as /downloads
MEDIA=/volume1/media
# Plex's settings file (the job reads Plex's token from it)
PLEX_PREFS="/volume1/plex/Library/Application Support/Plex Media Server/Preferences.xml"
# Languages a TV release may be in, as Sonarr names them, comma-separated (movies: always their original language)
TV_LANGUAGES=English
# User and group the apps run as (the same as Plex's), and the time zone
PUID=1000
PGID=100
TZ=Etc/UTC
